# Copy to .env locally; never commit real credentials.
# Required provider key for the model you use:
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Set production to require ORCHESTRATOR_API_KEY on /run and /history.
APP_ENV=development
ORCHESTRATOR_API_KEY=
# Comma-separated trusted browser origins. Do not use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_PROMPT_LENGTH=12000
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
